style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="(3) Revision C-1: the deadline is given as a clock time and words, not only a countdown (see evidence/usability-test.md)." vertex="1"><mxGeometry height="20" width="1500" x="20" y="614" as="geometry" /></mxCell><mxCell id="hlp_37" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="(4) No meeting point or phone number on H1 or H2 (QS-2)." vertex="1"><mxGeometry height="20" width="1500" x="20" y="636" as="geometry" /></mxCell><mxCell id="hlp_38" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="(5) H3 appears if the helper opens an old notification after the window; it is a normal state, not an error page." vertex="1"><mxGeometry height="20" width="1500" x="20" y="658" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>