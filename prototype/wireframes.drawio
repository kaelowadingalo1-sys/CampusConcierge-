;" value="" vertex="1"><mxGeometry height="470" width="270" x="1300" y="70" as="geometry" /></mxCell><mxCell id="req_47" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" value="R4  Terms locked" vertex="1"><mxGeometry height="22" width="330" x="1300" y="44" as="geometry" /></mxCell><mxCell id="req_48" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;align=center;fontStyle=1;" value="Terms locked" vertex="1"><mxGeometry height="34" width="270" x="1300" y="70" as="geometry" /></mxCell><mxCell id="req_49" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;align=center;fontStyle=1;" value="Confirmed. Terms are locked." vertex="1"><mxGeometry height="34" width="250" x="1310" y="114" as="geometry" /></mxCell><mxCell id="req_50" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="Meet at: Student centre, main entrance" vertex="1"><mxGeometry height="20" width="250" x="1310" y="160" as="geometry" /></mxCell><mxCell id="req_51" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="Helper: Name Surname, 71 000 000" vertex="1"><mxGeometry height="20" width="250" x="1310" y="184" as="geometry" /></mxCell><mxCell id="req_52" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="Price P20 - deadline 2 Oct 17:00" vertex="1"><mxGeometry height="20" width="250" x="1310" y="208" as="geometry" /></mxCell><mxCell id="req_53" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;align=center;fontStyle=1;" value="[ Report a problem ]" vertex="1"><mxGeometry height="34" width="250" x="1310" y="370" as="geometry" /></mxCell><mxCell id="req_54" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;" value="Helper not at the meeting point? Report it from here." vertex="1"><mxGeometry height="34" width="250" x="1310" y="415" as="geometry" /></mxCell><mxCell id="req_55" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="(1) Every field has a visible label above it that stays when typing. Placeholders are examples only." vertex="1"><mxGeometry height="20" width="1500" x="20" y="570" as="geometry" /></mxCell><mxCell id="req_56" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="(2) Price is shown before posting, so there is no surprise (BR-D2). Text, not colour, says it is fixed." vertex="1"><mxGeometry height="20" width="1500" x="20" y="592" as="geometry" /></mxCell><mxCell id="req_57" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="(3) Status is always a word in the status box. No status is shown by colour or icon alone." vertex="1"><mxGeometry height="20" width="1500" x="20" y="614" as="geometry" /></mxCell><mxCell id="req_58" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="(4) Expiry is a clock time plus minutes left. The minutes text updates every minute, not every second, so a screen reader is not flooded." vertex="1"><mxGeometry height="20" width="1500" x="20" y="636" as="geometry" /></mxCell><mxCell id="req_59" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="(5) Cancel is free and visible before acceptance (FR-06)." vertex="1"><mxGeometry height="20" width="1500" x="20" y="658" as="geometry" /></mxCell><mxCell id="req_60" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="(6) Contact and meeting details appear only on R4, after both confirm (QS-2, FR-05)." vertex="1"><mxGeometry height="20" width="1500" x="20" y="680" as="geometry" /></mxCell><mxCell id="req_61" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="(7) Backlog (R2b) says what is happening and that nothing is needed from the user (QS-3)." vertex="1"><mxGeometry height="20" width="1500" x="20" y="702" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="hlp" name="Helper"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hlp_1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" value="Helper wireframes (mobile width, 360 px layout). The offer notification opens H1 directly." vertex="1"><mxGeometry height="22" width="1500" x="20" y="5" as="geometry" /></mxCell><mxCell id="hlp_2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;align=center;" value="" vertex="1"><mxGeometry height="470" width="270" x="20" y="70" as="geometry" /></mxCell><mxCell id="hlp_3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" value="H1  New errand offer" vertex="1"><mxGeometry height="22" width="330" x="20" y="44" as="geometry" /></mxCell><mxCell id="hlp_4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;align=center;fontStyle=1;" value="New errand offer" vertex="1"><mxGeometry height="34" width="270" x="20" y="70" as="geometry" /></mxCell><mxCell id="hlp_5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;align=center;fontStyle=1;" value="Respond by 14:10 (9 min left)" vertex="1"><mxGeometry height="40" width="250" x="30" y="114" as="geometry" /></mxCell><mxCell id="hlp_6" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="Category: Parcel Collection" vertex="1"><mxGeometry height="20" width="250" x="30" y="166" as="geometry" /></mxCell><mxCell id="hlp_7" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="Price: P20" vertex="1"><mxGeometry height="20" width="250" x="30" y="188" as="geometry" /></mxCell><mxCell id="hlp_8" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="Deadline: 2 Oct 17:00" vertex="1"><mxGeometry height="20" width="250" x="30" y="210" as="geometry" /></mxCell><mxCell id="hlp_9" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" value="Task: Collect parcel from courier point, name on the label is T. Moeng" vertex="1"><mxGeometry height="50" width="250" x="30" y="234" as="geometry" /></mxCell><mxCell id="hlp_10" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=9;" value="Meeting point and contact details are shown after both of you confirm." vertex="1"><mxGeometry height="34" width="250" x="30" y="292" as="geometry" /></mxCell><mxCell id="hlp_11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;align=center;fontStyle=1;" value="[ Accept errand ]" vertex="1"><mxGeometry height="34" width="250" x="30" y="370" as="geometry" /></mxCell><mxCell id="hlp_12" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;align=center;fontStyle=1;" value="[ Decline ]" vertex="1"><mxGeometry height="34" width="250" x="30" y="412" as="geometry" /></mxCell><mxCell id="hlp_13" parent="1" style="text;html=1;strokeCol