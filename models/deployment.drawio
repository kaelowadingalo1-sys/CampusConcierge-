<mxfile host="Electron">
  <diagram id="dep" name="Deployment">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;" value="Deployment view: Campus Concierge (dashed boxes are trust boundaries)" vertex="1">
          <mxGeometry height="25" width="900" x="150" y="5" as="geometry" />
        </mxCell>

        <mxCell id="z_dev" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" value="User devices (campus wifi or mobile data)" vertex="1">
          <mxGeometry height="260" width="260" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="n_dev" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;&amp;lt;&amp;lt;device&amp;gt;&amp;gt; Student device&lt;/b&gt;&lt;br&gt;Web browser used by requester, helper and administrator" vertex="1">
          <mxGeometry height="100" width="200" x="50" y="140" as="geometry" />
        </mxCell>

        <mxCell id="z_srv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" value="Server zone (private network)" vertex="1">
          <mxGeometry height="420" width="520" x="380" y="60" as="geometry" />
        </mxCell>
        <mxCell id="n_app" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;&amp;lt;&amp;lt;node&amp;gt;&amp;gt; Application server&lt;/b&gt;&lt;br&gt;Single deployable application: Web/API layer, Errand Workflow (expiry scheduler, notification dispatcher), Category and Helper Administration, Dispute" vertex="1">
          <mxGeometry height="140" width="460" x="410" y="120" as="geometry" />
        </mxCell>
        <mxCell id="n_id" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Identity Service (mock)&lt;/b&gt;&lt;br&gt;seeded test accounts" vertex="1">
          <mxGeometry height="80" width="200" x="410" y="320" as="geometry" />
        </mxCell>
        <mxCell id="n_db" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;&amp;lt;&amp;lt;node&amp;gt;&amp;gt; Database server&lt;/b&gt;&lt;br&gt;Relational database" vertex="1">
          <mxGeometry height="80" width="200" x="670" y="320" as="geometry" />
        </mxCell>

        <mxCell id="z_ext" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=2;" value="External services" vertex="1">
          <mxGeometry height="260" width="260" x="1000" y="60" as="geometry" />
        </mxCell>
        <mxCell id="n_not" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;b&gt;Notification Service&lt;/b&gt;&lt;br&gt;sends status, offer and dispute notifications" vertex="1">
          <mxGeometry height="100" width="200" x="1030" y="140" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="n_dev" target="n_app" style="html=1;endArrow=open;endFill=0;" value="HTTPS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="n_app" target="n_db" style="html=1;endArrow=open;endFill=0;" value="database connection">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="n_app" target="n_id" style="html=1;endArrow=open;endFill=0;" value="identity check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="n_app" target="n_not" style="html=1;endArrow=open;endFill=0;" value="HTTPS, outbound only">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;" value="Contact and meeting details leave the server only through the confirmation gate in Errand Workflow. The database accepts connections from the application node only." vertex="1">
          <mxGeometry height="40" width="700" x="380" y="500" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
